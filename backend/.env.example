# Copy to backend/.env and adjust. The Django backend replaces Supabase for
# the Spine AI HR platform.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

PGDATABASE=spine_ai
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=127.0.0.1
PGPORT=5432

# 24h access-token TTL (seconds)
ACCESS_TOKEN_TTL=86400