# Spine AI — frontend environment template (safe defaults).
# Copy to `.env` for local dev and fill real values. NEVER commit `.env`.

# API URL the Vite dev client talks to (Django backend on localhost).
VITE_API_URL=http://127.0.0.1:8000

# Server-side API URL / service-role key (SSR only; never exposed to browser).
API_URL=http://127.0.0.1:8000
SERVICE_ROLE_KEY=
